<?xml version="1.0" encoding="utf-8"?>
<NEKTAR>
MOVEMENT_BLOCK
  <EXPANSIONS>
    <E COMPOSITE="C[101]" NUMMODES="NUMMODES_VAL" FIELDS="u" TYPE="MODIFIED" />
  </EXPANSIONS>

  <CONDITIONS>
    <SOLVERINFO>
            <I PROPERTY="EQTYPE"                VALUE="UnsteadyAdvection"   />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="UpwindType"            VALUE="Upwind"              />
      <I PROPERTY="Driver" VALUE="AdaptBL"/>
      <I PROPERTY="AdaptBL_surf" VALUE="103"/>
      <I PROPERTY="AdaptBL_y+surf" VALUE="ALL"/>
      <I PROPERTY="AdaptBL_transfer" VALUE="TRANSFER_METHOD"/>
    </SOLVERINFO>
        <TIMEINTEGRATIONSCHEME>
            <METHOD> RungeKutta </METHOD>
            <ORDER> 4 </ORDER>
        </TIMEINTEGRATIONSCHEME>
    <PARAMETERS>
      <P> NumRuns = NUMRUNS </P>
      <P> AdaptBL_nLayers = 4 </P>
      <P> AdaptBL_h_init = ADAPTBL_H </P>
      <P> AdaptBL_nq = 7 </P>
        <P> NumQuadPointsError = 19 </P>
          <P> TimeStep        = TIMESTEP_VAL       </P>
          <P> NumSteps        = NUMSTEPS_VAL       </P>
          <P> IO_CFLSteps     = 1       </P>
          <P> advx            = 0.0               </P>
          <P> advy            = ADVY              </P>
          <P> k               = 2*PI                     </P>
    </PARAMETERS>

    <VARIABLES>
      <V ID="0"> u </V>
    </VARIABLES>

    <BOUNDARYREGIONS>
      <B ID="0"> C[102]  </B>
      <B ID="1"> C[103]  </B>
      <B ID="2"> C[104]  </B>
      <B ID="3"> C[105]  </B>
    </BOUNDARYREGIONS>
    <BOUNDARYCONDITIONS>
      <!-- PERIODIC_<dir>:<ref> tags: stability_steps.sh -P replaces the whole
           line with a periodic condition pointing at region <ref>. Keep each
           Dirichlet condition on one line so that replacement works. -->
      <!-- top (y=1) -->
      <REGION REF="0">
        <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="sin(k*(x-advx*t))*cos(k*(y-advy*t)+PI*(x-advx*t))" /> <!-- PERIODIC_Y:1 -->
      </REGION>

      <!-- bottom (y=-1) -->
      <REGION REF="1">
        <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="sin(k*(x-advx*t))*cos(k*(y-advy*t)+PI*(x-advx*t))" /> <!-- PERIODIC_Y:0 -->
      </REGION>

      <!-- right (x=1) -->
      <REGION REF="2">
        <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="sin(k*(x-advx*t))*cos(k*(y-advy*t)+PI*(x-advx*t))" /> <!-- PERIODIC_X:3 -->
      </REGION>

      <!-- left (x=-1) -->
      <REGION REF="3">
        <D VAR="u" USERDEFINEDTYPE="TimeDependent" VALUE="sin(k*(x-advx*t))*cos(k*(y-advy*t)+PI*(x-advx*t))" /> <!-- PERIODIC_X:2 -->
      </REGION>

    </BOUNDARYCONDITIONS>

    <FUNCTION NAME="AdvectionVelocity">
        <E VAR="Vx" VALUE="advx" />
        <E VAR="Vy" VALUE="advy" />
    </FUNCTION>

    <!-- stability_steps.sh -H swaps the two values below for a zero exact
         solution and a white-noise initial condition, which makes the Error
         filter report ||u_h|| under the homogeneous operator. -->
    <FUNCTION NAME="ExactSolution">
        <E VAR="u" VALUE="EXACT_EXPR" />
    </FUNCTION>

    <FUNCTION NAME="InitialConditions">
        <E VAR="u" VALUE="IC_EXPR" />
    </FUNCTION>

  </CONDITIONS>

  <FILTERS>
    <FILTER TYPE="Error">
        <PARAM NAME="OutputFile">RESDIR/ErrorFile_v_ADVY_SAN_h_ADAPTBL_H_SAN_n_NUMRUNS_p_NUMMODES_VAL_m_OUTPUT_METHOD</PARAM>
        <PARAM NAME="OutputFrequency">1</PARAM>
        <PARAM NAME="ConsoleOutput">0</PARAM>
    </FILTER>
FIELDCONVERT_BLOCK
  </FILTERS>
</NEKTAR>
