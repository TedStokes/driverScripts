<?xml version="1.0" encoding="utf-8"?>
<NEKTAR>
MOVEMENT_BLOCK
  <EXPANSIONS>
    <E COMPOSITE="C[100]" NUMMODES="NUMMODES_VAL" FIELDS="u" TYPE="MODIFIED" />
  </EXPANSIONS>

  <CONDITIONS>
    <SOLVERINFO>
            <I PROPERTY="EQTYPE"                VALUE="UnsteadyAdvection"   />
            <I PROPERTY="Projection"            VALUE="DisContinuous"       />
            <I PROPERTY="AdvectionType"         VALUE="WeakDG"              />
            <I PROPERTY="UpwindType"            VALUE="Upwind"              />
      <I PROPERTY="Driver" VALUE="AdaptBL"/>
      <I PROPERTY="AdaptBL_surf" VALUE="102"/>
      <I PROPERTY="AdaptBL_y+surf" VALUE="ALL"/>
      <I PROPERTY="AdaptBL_transfer" VALUE="TRANSFER_METHOD"/>
    </SOLVERINFO>
        <TIMEINTEGRATIONSCHEME> 
            <METHOD> RungeKutta </METHOD> 
            <ORDER> 4 </ORDER> 
        </TIMEINTEGRATIONSCHEME>
    <PARAMETERS>
      <P> NumRuns = NUMRUNS </P>
      <P> AdaptBL_nLayers = 4 </P>
      <P> AdaptBL_h = ADAPTBL_H </P>
      <P> AdaptBL_nq = 5 </P>
        <P> NumQuadPointsError = 20 </P>
          <P> TimeStep        = 0.002/NumRuns             </P>
          <P> NumSteps        = 1  </P>
          <P> IO_CheckSteps   = IO_CHECKSTEPS               </P>
          <P> advx            = 0.0               </P>
          <P> advy            = 0.0               </P>
          <P> advz            = 0.0               </P>
          <P> k               = 2*PI * 2.5              </P>
    </PARAMETERS>

    <VARIABLES>
      <V ID="0"> u </V>
    </VARIABLES>

    <BOUNDARYREGIONS>
      <B ID="0"> C[103]  </B>
      <B ID="1"> C[4]  </B>
      <B ID="2"> C[2]  </B>
      <B ID="3"> C[1]  </B>
      <B ID="4"> C[3]  </B>
      <B ID="5"> C[102]  </B>
    </BOUNDARYREGIONS>
    <BOUNDARYCONDITIONS>
      <REGION REF="0"> <!-- noslip Wall -->
        <D VAR="u" USERDEFINEDTYPE="TimeDependent"
            VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
      </REGION>

      <REGION REF="1"> <!-- noslip Wall -->
        <D VAR="u" USERDEFINEDTYPE="TimeDependent"
            VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
      </REGION>

      <REGION REF="2"> <!-- Inflow -->
        <D VAR="u" USERDEFINEDTYPE="TimeDependent"
            VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
      </REGION>

      <REGION REF="3"> <!-- Outflow -->
        <D VAR="u" USERDEFINEDTYPE="TimeDependent"
            VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
      </REGION>

      <REGION REF="4"> <!-- symmetric slip -->
        <D VAR="u" USERDEFINEDTYPE="TimeDependent"
            VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
      </REGION>

      <REGION REF="5"> <!-- symmetric slip -->
        <D VAR="u" USERDEFINEDTYPE="TimeDependent"
            VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
      </REGION>

    </BOUNDARYCONDITIONS>

    <FUNCTION NAME="AdvectionVelocity">
        <E VAR="Vx" VALUE="advx" />
        <E VAR="Vy" VALUE="advy" />
        <E VAR="Vz" VALUE="advz" />
    </FUNCTION>

    <FUNCTION NAME="ExactSolution">
        <E VAR="u"  VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
    </FUNCTION>

    <FUNCTION NAME="InitialConditions">
        <E VAR="u"  VALUE="sin(k*x)*cos(k*y)*cos(k*z+2*PI*x)" />
    </FUNCTION>

  </CONDITIONS>

  <FILTERS>
    <FILTER TYPE="Error">
        <PARAM NAME="OutputFile">ErrorFile_n_NUMRUNS_h_ADAPTBL_H_SAN_p_NUMMODES_VAL_m_TRANSFER_METHOD</PARAM>
        <PARAM NAME="OutputFrequency">1</PARAM>
        <PARAM NAME="ConsoleOutput">0</PARAM>
    </FILTER>
  </FILTERS>
</NEKTAR>
