<NEKTAR>
    <MESHING>
        <INFORMATION>
            <I PROPERTY="CADFile" VALUE="squarentris.geo" />
            <I PROPERTY="MeshType" VALUE="2DBndLayer" />
        </INFORMATION>

        <PARAMETERS>
            <P PARAM="MinDelta" VALUE="2"    />
            <P PARAM="MaxDelta" VALUE="3"     />
            <P PARAM="EPS"      VALUE="0.01"     />

            <P PARAM="Order"    VALUE="5"       />

            <P PARAM="BndLayerSurfaces"  VALUE="1" />
            <P PARAM="BndLayerThickness"  VALUE="2" />
            <P PARAM="BndLayerLayers"      VALUE="1"       />
            <P PARAM="BndLayerProgression" VALUE="1"     />
        </PARAMETERS>
    </MESHING>
</NEKTAR>
